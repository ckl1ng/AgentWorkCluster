:9010 {
  encode zstd gzip

  # The internal auth endpoint is only available to agent-api over loopback.
  handle /internal/* {
    respond 404
  }

  handle /qq/webhook* {
    reverse_proxy 127.0.0.1:9013
  }

  @agent_api path /api/v1/agents* /api/v1/agent-conversations* /api/v1/agent-runs* /api/v1/tools* /api/v1/evaluations* /api/v1/local-agent* /api/v1/tasks* /api/v1/task-dispatch-events* /api/v1/notifications*
  handle @agent_api {
    reverse_proxy 127.0.0.1:9011
  }

  handle /agent/ws* {
    reverse_proxy 127.0.0.1:9011
  }

  handle /task/ws* {
    reverse_proxy 127.0.0.1:9011
  }

  handle /local-agent/ws* {
    reverse_proxy 127.0.0.1:9011
  }

  @chat_api path /api* /ws* /healthz
  handle @chat_api {
    reverse_proxy 127.0.0.1:9012
  }

  handle {
    root * /var/lib/chat-server/client
    try_files {path} /index.html
    file_server
  }
}
