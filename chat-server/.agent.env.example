# Copy this file to .agent.env for start.sh, or to /etc/chat-server/agent.env
# for systemd. Keep the production file mode 0600.
# Generate AGENT_MASTER_KEY with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AGENT_SERVICE_SECRET=replace-with-a-long-random-service-secret
AGENT_MASTER_KEY=replace-with-a-fernet-key

# PostgreSQL and Redis may run locally or be managed services. Do not expose
# either listener publicly. Redis mode starts a separate durable Agent Worker.
AGENT_DATABASE_URL=postgresql://agent:replace-with-a-strong-password@127.0.0.1:5432/agent
REDIS_URL=redis://127.0.0.1:6379/0

# Caddy owns the public :9010 listener. Application processes use loopback.
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=9012
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=9011
CHAT_AUTH_INTROSPECTION_URL=http://127.0.0.1:9012/internal/v1/auth/introspect
AGENT_ALLOW_HTTP=false
QQ_GATEWAY_INTERNAL_URL=http://127.0.0.1:9013

# Set true to include the root-level QQ Gateway in ../start.sh/../stop.sh.
QQ_GATEWAY_ENABLED=false
QQ_GATEWAY_INTERNAL_URL=http://127.0.0.1:9013
QQ_GATEWAY_HOST=127.0.0.1
QQ_GATEWAY_PORT=9013
QQ_GATEWAY_DATABASE_PATH=../qq-gateway/data/qq-gateway.db
QQ_GATEWAY_MASTER_KEY=replace-with-a-valid-fernet-key
QQ_MAX_EVENT_TASKS=32

# Optional legacy QQ credentials. The recommended path enters AppID/AppSecret
# in the Agent settings page, where the Gateway encrypts them at rest.
QQ_APP_ID=replace-with-qq-app-id
QQ_CLIENT_SECRET=replace-with-qq-client-secret
QQ_API_BASE_URL=https://api.bot.qq.com
QQ_TOKEN_API_BASE_URL=https://bots.qq.com
QQ_BOT_ID=replace-with-qq-bot-id
QQ_DEFAULT_AGENT_ID=replace-with-agent-id
QQ_DEFAULT_OWNER_USER_ID=replace-with-owner-user-id
QQ_AGENT_RUN_TIMEOUT_SECONDS=240
QQ_PASSIVE_REPLY_WINDOW_SECONDS=290
QQ_EVENT_RETRY_AFTER_SECONDS=10
QQ_EVENT_RETRY_INTERVAL_SECONDS=5
