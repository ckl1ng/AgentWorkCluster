# Copy this file to .agent.env for start.sh, or to /etc/chat-server/agent.env
# for systemd. Keep the production file mode 0600.
# Generate AGENT_MASTER_KEY with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AGENT_SERVICE_SECRET=replace-with-a-long-random-service-secret
AGENT_MASTER_KEY=replace-with-a-fernet-key

# PostgreSQL and Redis may run locally or be managed services. Do not expose
# either listener publicly. Redis mode starts a separate durable Agent Worker.
AGENT_DATABASE_URL=postgresql://agent:replace-with-a-strong-password@127.0.0.1:5432/agent
REDIS_URL=redis://127.0.0.1:6379/0

# Caddy owns the public :9010 listener. Application processes use loopback.
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=9012
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=9011
CHAT_AUTH_INTROSPECTION_URL=http://127.0.0.1:9012/internal/v1/auth/introspect
AGENT_ALLOW_HTTP=false
